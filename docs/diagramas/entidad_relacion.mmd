    AUTH_USERS {
        uuid id PK "Supabase Auth"
        text email
    }
    PROFILES {
        uuid user_id PK, FK
        text username
        int xp
        timestamptz created_at
        timestamptz updated_at
    }
    PREFERENCES {
        uuid user_id PK, FK
        smallint daily_goal
        text appearance FK
        smallint reminder_weekday
        smallint reminder_hour
        smallint reminder_minute
        timestamptz updated_at
    }
    APPEARANCE_MODES {
        text id PK
        text name UK
    }
    STREAKS {
        uuid user_id PK, FK
        int current_days
        date last_practice_date
        int best_days
        smallint freezes
        timestamptz updated_at
    }
    CATEGORIES {
        text id PK
        text name UK
    }
    LESSONS {
        text id PK
        text category_id FK
        text title
        text description
        smallint difficulty
        smallint position UK
    }
    SIGNS {
        text id PK
        text lesson_id FK
        text name
        text description
        smallint position "UK con lesson_id"
    }
    CHALLENGE_PERIODS {
        text id PK
        text name UK
    }
    CHALLENGES {
        text id PK
        text period_id FK
        text title
        int target
        int reward_xp
    }
    CHEST_RARITIES {
        text id PK
        text name UK
        int reward_xp
        smallint reward_freezes
    }
    CHESTS {
        text lesson_id PK, FK
        text rarity_id FK
    }
    USER_SIGNS {
        uuid user_id PK, FK
        text sign_id PK, FK
        timestamptz learned_at
    }
    ATTEMPTS {
        bigint id PK
        uuid user_id FK
        text sign_id FK
        boolean correct
        timestamptz attempted_at
    }
    USER_CHALLENGES {
        uuid user_id PK, FK
        text challenge_id PK, FK
        timestamptz claimed_at
    }
    USER_CHESTS {
        uuid user_id PK, FK
        text lesson_id PK, FK
        timestamptz opened_at
    }
    SUPPORT_CATEGORIES {
        text id PK
        text name UK
    }
    TICKET_STATUSES {
        text id PK
        text name UK
    }
    SUPPORT_TICKETS {
        uuid id PK "generado en el teléfono"
        uuid user_id FK
        text category FK
        text status FK
        text message
        text screen
        text app_version
        text platform
        text device_tier
        timestamptz created_at
        timestamptz resolved_at
    }
