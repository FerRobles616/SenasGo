    }
    PARAMETRO_FORMATIVO {
        TEXT id PK
        TEXT nombre UK
        INTEGER orden
    }
    INTENTO {
        INTEGER id PK
        TEXT usuario_id FK
        TEXT sena_id FK
        TEXT leccion_id FK
        TEXT fecha
        TEXT modo "edge_ai | conceptual"
        INTEGER nivel_usuario
        INTEGER correcto
        INTEGER xp_otorgado "0 o 10"
    }
    INTENTO_PARAMETRO {
        INTEGER intento_id PK, FK
        TEXT parametro_id PK, FK
        TEXT estado "bien | a_mejorar | no_evaluado"
        TEXT indicacion
    }
    SENA_APRENDIDA {
        TEXT usuario_id PK, FK
        TEXT sena_id PK, FK
        TEXT aprendida_en
    }
    LECCION_COMPLETADA {
        TEXT usuario_id PK, FK
        TEXT leccion_id PK, FK
        TEXT completada_en
    }
    INSIGNIA {
        TEXT id PK
        TEXT nombre UK
        TEXT descripcion
    }
    USUARIO_INSIGNIA {
        TEXT usuario_id PK, FK
