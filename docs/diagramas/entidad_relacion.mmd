    USUARIO {
        TEXT id PK "UUID local"
        TEXT nombre
        INTEGER nivel "1 a 5"
        INTEGER xp ">= 0"
        TEXT leccion_actual_id FK
        TEXT creado_en
        TEXT ultimo_ingreso
    }
    ESTADO_JUEGO {
        TEXT usuario_id PK, FK
        INTEGER racha_dias
        TEXT fecha_racha
        INTEGER energia "0 a 5"
        TEXT energia_desde
    }
    CATEGORIA {
        TEXT id PK
        TEXT nombre UK
    }
    LECCION {
        TEXT id PK
        TEXT titulo
        TEXT descripcion
        INTEGER dificultad "1 a 5"
        INTEGER orden UK
    }
    SENA {
        TEXT id PK
        TEXT nombre
        TEXT categoria_id FK
        TEXT descripcion
        TEXT imagen
        TEXT animacion
        INTEGER rive_indice UK
        TEXT etiqueta_modelo
        INTEGER activa
        INTEGER validada_lspy
    }
    SENA_ETIQUETA {
        TEXT sena_id PK, FK
        TEXT etiqueta PK
    }
    LECCION_SENA {
        TEXT leccion_id PK, FK
        TEXT sena_id PK, FK
        INTEGER orden
    }
    REFERENCIA_SENA {
        TEXT sena_id PK, FK
