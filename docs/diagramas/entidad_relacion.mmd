    SIGNS ||--o{ USER_SIGNS : "es aprendida en"
    SIGNS ||--o{ ATTEMPTS : "se practica en"
    CHALLENGE_PERIODS ||--o{ CHALLENGES : "tipifica"
    CHALLENGES ||--o{ USER_CHALLENGES : "se reclama en"
    CHESTS ||--o{ USER_CHESTS : "se abre en"
