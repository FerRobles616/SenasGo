    PROFILES ||--o{ ATTEMPTS : "realiza"
    PROFILES ||--o{ USER_CHALLENGES : "reclama"
    PROFILES ||--o{ USER_CHESTS : "abre"
    PROFILES ||--o{ SUPPORT_TICKETS : "envía"
